APP_NAME=LeLog
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DIRECT_HOST=127.0.0.1
DB_DIRECT_PORT=5432
DB_DATABASE=lelog
DB_USERNAME=lelog
DB_PASSWORD=lelog
DB_PERSISTENT=false

LOGS_MAX_BATCH_SIZE=1000
LOGS_FUTURE_TOLERANCE_SECONDS=300
LOGS_QUERY_DEFAULT_LIMIT=100
LOGS_QUERY_MAX_LIMIT=1000
LOGS_RETENTION_DAYS=90
LOGS_RETENTION_INTERVAL_SECONDS=60
LOGS_RETENTION_BATCH_SIZE=10000
LOGS_RETENTION_MAX_BATCHES=10
LOGS_DATABASE_WORKER_LIMIT=4
LOGS_SHUTDOWN_TIMEOUT_SECONDS=30

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=null

CACHE_STORE=array
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
