{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "ahmad-shawkat/lelog",
    "type": "project",
    "description": "A durable, PostgreSQL-backed log ingestion and query service.",
    "keywords": ["laravel", "logging", "postgresql"],
    "license": "MIT",
    "require": {
        "php": "8.5.*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "@php vendor/bin/phpstan analyse --no-progress",
        "format": "@php vendor/bin/pint",
        "format:test": "@php vendor/bin/pint --test",
        "build": [
            "@php artisan config:cache",
            "@php artisan route:cache"
        ],
        "quality": [
            "@format:test",
            "@analyse",
            "@test",
            "@build"
        ],
        "test": [
            "@php -r \"is_dir('bootstrap/cache') || mkdir('bootstrap/cache', 0777, true);\"",
            "@php vendor/bin/phpunit"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.5.9"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
